# Environment variables TSG expects. Copy to .env.local and fill in.
# .env.local is gitignored; this file is the tracked record of what the
# live environment needs, so a deploy does not have to guess.

# --- Supabase ---------------------------------------------------------
# The project URL and the public anon key. NEXT_PUBLIC_ by design: these
# are the two the browser-side Auth client will use once the mock in
# lib/auth/supabase-mock.ts is swapped for the real SDK.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses row-level security completely.
#
# Deliberately not NEXT_PUBLIC_: pending_inputs has RLS enabled with no
# policies at all (supabase/migrations/0001_initial.sql), so this key is
# the only thing that can reach it - and it holds a full address and a
# complete financial picture. Prefixing it NEXT_PUBLIC_ would inline it
# into client JavaScript and hand every visitor read access to every
# customer's row.
#
# Set it in Vercel as an environment variable scoped to the server, never
# in any file that ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
